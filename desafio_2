CREATE TABLE regiao (
  id_regiao INT(10) PRIMARY KEY,
  nome_da_regiao VARCHAR(50) NOT NULL,
  estado VARCHAR(20) NOT NULL, 
  pais VARCHAR(20) NOT NULL
);

CREATE TABLE usina (
  id_usina INT(10) PRIMARY KEY,
  nome_da_usina VARCHAR(50) NOT NULL,
  fonte_eletr VARCHAR(50) NOT NULL,
  FOREIGN KEY(id_regiao)
);

CREATE TABLE geracao(
  id_geracao INT(10) PRIMARY KEY,
  tipo_gerador VARCHAR(50) NOT NULL,
  registro DATE NOT NULL,
  qtd_gerador FLOAT NOT NULL,
  FOREIGN KEY(id_usina)
);

